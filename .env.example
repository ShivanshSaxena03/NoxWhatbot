# ==========================================
# JARVIS WHATSAPP AI ASSISTANT - ENV CONFIG
# ==========================================

# Database Connection (Neon PostgreSQL)
# Example: postgresql://user:password@ep-cool-db-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://user:password@ep-cool-db-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-cool-db-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# OpenRouter AI API Configuration
OPENROUTER_API_KEY="sk-or-v1-your-openrouter-key-here"
OPENROUTER_MODEL="openrouter/auto" # OpenRouter auto-router (selects best model dynamically)
OPENROUTER_SITE_NAME="Jarvis WhatsApp Assistant"

# Security & Encryption Vault
# Generate 32-byte hex key (e.g. openssl rand -hex 32)
VAULT_MASTER_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
JWT_SECRET="super-secret-jwt-key-change-in-production"

# Dashboard Login Credentials
ADMIN_USERNAME="shivansh"
ADMIN_PASSWORD="password123"

# Web Dashboard & API Port
PORT=3000
WEB_PORT=3000
SERVER_PORT=3001

# System Default Timezone
TIMEZONE="UTC"

# WhatsApp Session Persistence Directory
WA_SESSION_DIR="./baileys_auth_info"
